# Copy this file to `.env` and fill in the values:
#   macOS / Linux:        cp .env.example .env
#   Windows (PowerShell): Copy-Item .env.example .env
#
# `.env` is gitignored, never commit secrets. When you add a variable here, also add it to the
# schema in `src/env.js` (otherwise the app won't see it / will fail validation).

# ── Auth.js (NextAuth v5) ────────────────────────────────────────────
# Generate one with: npx auth secret   (works on every OS)
AUTH_SECRET=""

# Optional: Discord OAuth. Login providers are only enabled when their credentials are set.
# Create an app at https://discord.com/developers/applications
# Redirect URL: http://localhost:3000/api/auth/callback/discord
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# Number of reverse proxies (load balancer, nginx, Caddy...) in front of the app that append the
# client address to X-Forwarded-For. Used to find the real client IP for sign-up / sign-in rate
# limits. Local dev with no proxy: 0. Staging / production: set it to the real number of proxies.
# With 0 and no proxy, a client can spoof its IP, so the per-email limits are the real protection.
TRUSTED_PROXY_COUNT=0

# ── Database (PostgreSQL, started with `pnpm db:up`) ────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/dovivo"
