# Copy this file to `.env` and fill in the values:
#   macOS / Linux:        cp .env.example .env
#   Windows (PowerShell): Copy-Item .env.example .env
#
# `.env` is gitignored, never commit secrets. When you add a variable here, also add it to the
# schema in `src/env.js` (otherwise the app won't see it / will fail validation).

# ── Auth.js (NextAuth v5) ────────────────────────────────────────────
# Generate one with: npx auth secret   (works on every OS)
AUTH_SECRET=""

# Optional: Discord OAuth. Login providers are only enabled when their credentials are set.
# Create an app at https://discord.com/developers/applications
# Redirect URL: http://localhost:3000/api/auth/callback/discord
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# Number of reverse proxies (load balancer, nginx, Caddy...) in front of the app that append the
# client address to X-Forwarded-For. Used to find the real client IP for sign-up / sign-in rate
# limits. Local dev with no proxy: 0. Staging / production: set it to the real number of proxies.
# With 0 the client IP is unknown (any forwarding header could be forged), so the per-IP limits
# are off and only the per-email sign-in limit applies.
TRUSTED_PROXY_COUNT=0

# ── Database (PostgreSQL, started with `pnpm db:up`) ────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/dovivo"

# ── Photo storage (US-18, any S3-compatible service) ───────────────
# Local: `pnpm storage:up` starts RustFS in Docker with these values (console on
# http://localhost:9001, user/password rustfsadmin), then run `pnpm storage:setup` once to create
# the bucket. Staging / production: the bucket's endpoint, keys and public URL.
# Leave S3_ENDPOINT empty for AWS S3. Without S3_BUCKET the photo procedures answer an error.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="dovivo-photos"
S3_ACCESS_KEY_ID="rustfsadmin"
S3_SECRET_ACCESS_KEY="rustfsadmin"
# Local S3 servers need path-style URLs (http://host/bucket/key). AWS S3 and R2: false.
S3_FORCE_PATH_STYLE="true"
# Public base URL of the bucket: photo URLs are `${S3_PUBLIC_URL}/${key}`.
S3_PUBLIC_URL="http://localhost:9000/dovivo-photos"
# Only for `pnpm storage:setup`: origins allowed to upload from the browser (comma-separated).
S3_CORS_ORIGINS="http://localhost:3000"
